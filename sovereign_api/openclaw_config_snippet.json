{
  "_comment": "Add this to your /root/.openclaw/openclaw.json under the 'models' section",
  
  "models": {
    "mode": "merge",
    "providers": {
      "sovereign": {
        "_comment": "Universal proxy for multi-provider inference",
        "baseUrl": "http://127.0.0.1:3000/v1",
        "apiKey": "sk-local-proxy",
        "api": "openai",
        "headers": {
          "User-Agent": "OpenClaw-Sovereign/1.0"
        },
        "models": [
          {
            "id": "k2p5",
            "name": "Kimi K2.5 (via proxy)",
            "reasoning": true,
            "contextWindow": 131072,
            "maxTokens": 32768,
            "provider": "kimi"
          },
          {
            "id": "llama3.2",
            "name": "Llama 3.2 (local Ollama)",
            "reasoning": false,
            "contextWindow": 128000,
            "maxTokens": 8192,
            "provider": "ollama"
          },
          {
            "id": "phi3",
            "name": "Phi-3 (local edge)",
            "reasoning": false,
            "contextWindow": 32768,
            "maxTokens": 4096,
            "provider": "ollama"
          },
          {
            "id": "gpt-4o",
            "name": "GPT-4o (OpenAI)",
            "reasoning": true,
            "contextWindow": 128000,
            "maxTokens": 16384,
            "provider": "openai"
          },
          {
            "id": "llama-3.1-70b",
            "name": "Llama 3.1 70B (Groq)",
            "reasoning": false,
            "contextWindow": 8192,
            "maxTokens": 4096,
            "provider": "groq"
          }
        ]
      },
      
      "_comment": "Keep Kimi as fallback",
      "kimi-coding": {
        "baseUrl": "https://api.kimi.com/coding",
        "apiKey": "${KIMI_API_KEY}",
        "api": "anthropic-messages",
        "models": [
          {
            "id": "k2p5",
            "name": "Kimi K2.5 (direct)",
            "reasoning": true,
            "contextWindow": 131072,
            "maxTokens": 32768
          }
        ]
      }
    }
  },
  
  "agents": {
    "defaults": {
      "model": {
        "primary": "sovereign/k2p5",
        "fallback": "kimi-coding/k2p5"
      },
      "models": {
        "sovereign/k2p5": {
          "alias": "Kimi K2.5 (Sovereign)"
        },
        "sovereign/llama3.2": {
          "alias": "Llama 3.2 (Local)"
        },
        "kimi-coding/k2p5": {
          "alias": "Kimi K2.5 (Direct Fallback)"
        }
      }
    }
  }
}
